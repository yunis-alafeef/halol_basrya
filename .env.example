# Database connection (PostgreSQL) - optional, falls back to in-memory store if unset
DATABASE_URL=postgresql://user:password@localhost:5432/halol_basrya?schema=public

# Session authentication secret (for JWT token encryption)
SESSION_SECRET=halol_basrya_secret_key_change_in_production_32chars!

# Site URL for canonical metadata
NEXT_PUBLIC_SITE_URL=https://halol-basrya.example.com

# Vercel Blob storage token for image uploads (optional, falls back to data URI)
BLOB_READ_WRITE_TOKEN=

# Resend API credentials for contact form submissions (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@halol-basrya.example.com
CONTACT_TO_EMAIL=info@halol-basrya.example.com

# Initial admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!
